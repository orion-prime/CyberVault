# Copy to .env and replace every placeholder before deployment.
POSTGRES_DB=cybervault
POSTGRES_USER=cybervault_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://cybervault_app:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/cybervault

CYBERVAULT_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CYBERVAULT_TOKEN_TTL_SECONDS=3600
CYBERVAULT_BOOTSTRAP_USERNAME=investigator
CYBERVAULT_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_14_CHARACTERS
CYBERVAULT_CORS_ORIGINS=http://localhost:8080
